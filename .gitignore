# Personal / secrets — never commit
CLAUDE.local.md
.env
.env.*
*.key
*.pem
secrets/

# Claude Code transcript backups (local recovery only; can be large)
.claude/backups/*
!.claude/backups/.gitkeep

# First-run onboarding marker — per-clone, written by the start skill
.claude/.initialised

# Per-machine Claude Code settings (optional hooks, written by the start skill)
.claude/settings.local.json

# Session artefacts written by the optional hooks — never part of the template
state/handover-latest.md
state/session-log.md

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs / temp
*.log
tmp/
